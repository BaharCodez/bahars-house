// Prisma schema — users/accounts/sessions are the Auth.js shape; Book and
// Annotation hold the shared reading data.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth.js models ------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // Set only for email/password accounts; null for OAuth-only users.
  passwordHash  String?
  createdAt     DateTime  @default(now())

  accounts    Account[]
  sessions    Session[]
  books       Book[]
  annotations Annotation[]
  progress    ReadingProgress[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// --- Reading data --------------------------------------------------------

model Book {
  id           String   @id @default(cuid())
  title        String
  author       String
  coverDataUrl String?
  // The raw EPUB file. Fine in SQLite for now; revisit for large libraries.
  data         Bytes
  ownerId      String
  createdAt    DateTime @default(now())

  owner       User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  annotations Annotation[]
  progress    ReadingProgress[]
}

model Annotation {
  id       String @id @default(cuid())
  bookId   String
  userId   String
  cfiRange String
  text     String
  comment  String
  // What kind of passage this is: "idea" | "definition" | "example" |
  // "question". Books ask what a passage *is*; the daily room's Highlight.grasp
  // asks how well you understood it. Two vocabularies, one mechanism.
  kind      String   @default("idea")
  createdAt DateTime @default(now())

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bookId])
}

// --- Writing room ----------------------------------------------------------

// A blog post, written in markdown. Drafts have publishedAt = null and are
// only visible when signed in.
model Post {
  id          String    @id @default(cuid())
  title       String
  content     String
  tags        String[]  @default([]) // freeform topics, reused across posts
  coverImage  String? // purposeful cover (already cropped); else the body's first image
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// An image embedded in a post — stored the same way books are (bytes in
// the DB), served from /api/images/[id].
model Image {
  id        String   @id @default(cuid())
  mime      String
  data      Bytes
  createdAt DateTime @default(now())
}

// A sticky note on the hobby board: something to read about, write about,
// explore, or solve.
model Idea {
  id        String   @id @default(cuid())
  bucket    String // "read" | "write" | "explore" | "solve"
  text      String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// --- Hallway -------------------------------------------------------------

// A frame hanging on the hallway wall: a job, a project, or any achievement
// worth showing off. Added/removed from the hallway page while signed in.
model Frame {
  id        String   @id @default(cuid())
  kind      String // "job" | "project" | "achievement"
  title     String
  subtitle  String   @default("")
  detail    String   @default("")
  years     String? // freeform: "2023–now", "summer 2024", …
  link      String?
  tags      String[] @default([]) // freeform labels for filtering the wall
  sort      Int      @default(0)
  createdAt DateTime @default(now())
}

// An article saved to the daily room's shelf. `favorite` lifts it into the
// "special pile" — the reads worth keeping.
//
// `blocks` is the readable body pulled in from the source and cached so it can
// be read (and highlighted) here in the house: an ordered array of
// { t, s } chunks — see app/lib/article.ts. Null until it's been pulled in.
model Bookmark {
  id        String    @id @default(cuid())
  url       String    @unique
  title     String
  source    String    @default("")
  favorite  Boolean   @default(false)
  // Which shelf it sits on — freeform, made up as you go. "" is the catch-all
  // shelf everything lands on until it's put somewhere.
  shelf     String    @default("")
  byline    String    @default("")
  blocks    Json?
  wordCount Int       @default(0)
  fetchedAt DateTime?
  createdAt DateTime  @default(now())

  highlights Highlight[]
}

// A passage marked up while reading an article in the house — the point being
// to separate what actually landed from what only looked like it did.
// `grasp` is "got" | "half" | "lost"; the half/lost ones pile up into the
// daily room's "what I don't get yet" list.
//
// Anchored by block index + character range, with the quote kept alongside so
// a highlight can find itself again if the article is pulled in afresh.
model Highlight {
  id         String   @id @default(cuid())
  bookmarkId String
  block      Int
  start      Int
  end        Int
  quote      String
  grasp      String
  note       String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  bookmark Bookmark @relation(fields: [bookmarkId], references: [id], onDelete: Cascade)

  @@index([bookmarkId])
}

// A single page view by a visitor (never the owner). Location is coarse
// (from the host's geo headers); ipHash is salted, never a raw IP.
model Visit {
  id        String   @id @default(cuid())
  path      String
  country   String   @default("")
  city      String   @default("")
  region    String   @default("")
  referrer  String   @default("")
  device    String   @default("")
  ipHash    String   @default("")
  visitorName String @default("") // only set if the visitor was signed in
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// A self-paced learning path (a book, a subject) broken into small steps.
model Roadmap {
  id        String        @id @default(cuid())
  slug      String        @unique
  title     String
  subtitle  String        @default("")
  emoji     String        @default("🗺️")
  sort      Int           @default(0)
  private   Boolean       @default(false) // owner-only (e.g. personal STAR stories)
  createdAt DateTime      @default(now())
  steps     RoadmapStep[]
}

// One chunk of a roadmap: read/learn it, self-test, tick it off. `done` is the
// owner's own progress (single-owner site). Advances only when marked done.
//
// `confidence` is a separate axis from `done`: having been through a pattern
// isn't the same as being able to write it cold. 0 unrated, 1 lost, 2 shaky,
// 3 solid — it feeds the DSA roadmap's strong/weak board.
model RoadmapStep {
  id         String  @id @default(cuid())
  roadmapId  String
  order      Int
  group      String  @default("") // section header, e.g. "Ch 2" or "Scaling"
  title      String
  detail     String  @default("")
  link       String?
  recallQ    String  @default("")
  recallA    String  @default("")
  done       Boolean @default(false)
  confidence Int     @default(0)

  roadmap Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@index([roadmapId])
}

// One LeetCode problem drilled for a DSA pattern, and how it went: "solved"
// (came out on its own) or "struggled" (needed the answer, or crawled).
// `pattern` is the RoadmapStep title it was drilled under, which is how the
// strong/weak board groups them.
model ProblemLog {
  id      String @id @default(cuid())
  url     String @unique
  name    String
  pattern String
  status  String // "solved" | "struggled"
  // True when it came from the LeetCode sync rather than being ticked by
  // hand. A hand-set verdict is never overwritten by the sync — "I struggled
  // with this" is the honest signal, and eventually solving it doesn't undo
  // that.
  auto Boolean @default(false)
  // How hard it felt, your scale: 1 brutal → 5 easy. 0 means unrated.
  // Separate from LeetCode's own easy/medium/hard, which says nothing about
  // whether *you* could see it.
  rating    Int      @default(0)
  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pattern])
}

// Small bits of house configuration that want a UI rather than a redeploy —
// currently just the LeetCode username the DSA board syncs from.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// One tick per habit per day — powers the daily room's streak board.
model DailyTick {
  id        String   @id @default(cuid())
  kind      String // "article" | "spanish"
  day       String // visitor-local date, "YYYY-MM-DD"
  createdAt DateTime @default(now())

  @@unique([kind, day])
}

// Per-user reading position in a book (synced across that user's devices).
model ReadingProgress {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  cfi       String
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
}
